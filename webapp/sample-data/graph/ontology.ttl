@prefix geo: <http://cdp.demo/geo#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# ---- Ontology: classes ----
geo:Vessel a owl:Class ; rdfs:label "Vessel" .
geo:AisTrack a owl:Class ; rdfs:label "AisTrack" .
geo:VesselType a owl:Class ; rdfs:label "VesselType" .
geo:Mmsi a owl:Class ; rdfs:label "Mmsi" .
geo:Flag a owl:Class ; rdfs:label "Flag" .
geo:Region a owl:Class ; rdfs:label "Region" .
geo:AnomalyType a owl:Class ; rdfs:label "AnomalyType" .

# ---- Ontology: object properties (domain/range) ----
geo:hasType a owl:ObjectProperty ; rdfs:domain geo:Vessel , geo:AisTrack ; rdfs:range geo:VesselType .
geo:operatesIn a owl:ObjectProperty ; rdfs:domain geo:Vessel , geo:AisTrack ; rdfs:range geo:Region .
geo:flaggedAs a owl:ObjectProperty ; rdfs:domain geo:Vessel ; rdfs:range geo:Flag .
geo:broadcasts a owl:ObjectProperty ; rdfs:domain geo:Vessel ; rdfs:range geo:Mmsi .
geo:classifiedAs a owl:ObjectProperty ; rdfs:domain geo:Vessel , geo:AisTrack ; rdfs:range geo:AnomalyType .
geo:sharesIdentityWith a owl:ObjectProperty ; rdfs:domain geo:Vessel ; rdfs:range geo:Vessel .


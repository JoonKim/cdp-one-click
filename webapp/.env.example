# Copy to .env and edit. Loaded automatically by run.sh.
# (.env is git-ignored; .env.example is safe to commit.)

# ---- Web app ----
HOST=127.0.0.1
PORT=8888
# Point the map at your own GeoJSON (defaults to the bundled sample data):
# ENTITY_DIR=/Users/you/Projects/geomesa-hbase-geojson-demo/data/entity

# ---- GeoServer (optional; enables the "Create GeoServer Layer" button) ----
# GEOSERVER_URL=https://host/geoserver
# GEOSERVER_USER=admin
# GEOSERVER_PASSWORD=geoserver
# GEOSERVER_WORKSPACE=geomesa
# GEOSERVER_DATASTORE=geomesa_hbase
# GEOMESA_CATALOG=geomesa
# GEOMESA_ZOOKEEPERS=

# ---- Phoenix spatial demo (demo-scripts/phoenix_spatial_demo.py) ----
# Not used by the web app, but handy to keep here for the demo.
# PHOENIX_URL=https://<cod-gateway>/<cod>/cdp-proxy-api/avatica/
# PHOENIX_USER=<workload_user>
# PHOENIX_PASSWORD=<workload_password>
